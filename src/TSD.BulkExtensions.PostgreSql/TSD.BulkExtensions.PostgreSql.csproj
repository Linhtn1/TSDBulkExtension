<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>TSD.BulkExtensions.PostgreSql</PackageId>
    <Description>PostgreSQL adapter for TSD.BulkExtensions: COPY BINARY streaming plus UPDATE ... FROM / INSERT ... SELECT / DELETE ... USING for Insert, Update, Delete, Upsert, Sync and Read.</Description>
    <RootNamespace>TSD.BulkExtensions.PostgreSql</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\TSD.BulkExtensions.Core\TSD.BulkExtensions.Core.csproj" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="ILLink.Descriptors.xml" LogicalName="ILLink.Descriptors.xml" />
  </ItemGroup>

</Project>
