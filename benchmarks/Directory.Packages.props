<Project>
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Packages.props', '$(MSBuildThisFileDirectory)../'))" />

  <!-- Benchmark reference only: the last MIT-licensed upstream release. Scoped to benchmarks/ so no shipping project can
       resolve it. Never bump past 6.5.6 (dual license from 6.7.0). -->
  <ItemGroup>
    <PackageVersion Include="EFCore.BulkExtensions" Version="[6.5.6]" />
    <PackageVersion Include="BenchmarkDotNet" Version="0.15.8" />
  </ItemGroup>
</Project>
